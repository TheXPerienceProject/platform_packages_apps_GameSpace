type gamespace_app, domain;
typeattribute gamespace_app mlstrustedsubject;
app_domain(gamespace_app)

# SurfaceFlinger / FPS
allow gamespace_app surfaceflinger_service:service_manager find;
binder_call(gamespace_app, surfaceflinger)

# Hardware
allow gamespace_app sysfs_devices_system_cpu:file rw_file_perms;
allow gamespace_app sysfs_batteryinfo:file r_file_perms;
allow gamespace_app proc_meminfo:file r_file_perms;
allow gamespace_app proc_stat:file r_file_perms;

# Generic sysfs traversal
allow gamespace_app sysfs:dir r_dir_perms;
allow gamespace_app sysfs:lnk_file { getattr read };

# MediaTek / Mali GPU
allow gamespace_app sysfs:file r_file_perms;
allow gamespace_app sysfs_therm:file r_file_perms;

# Service Manager
allow gamespace_app servicemanager:binder { call transfer };
allow gamespace_app activity_service:service_manager find;
allow gamespace_app game_service:service_manager find;
